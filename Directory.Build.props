<!--
  Settings applied to every project under this folder.
  MSBuild picks this file up automatically, so no .csproj has to repeat them.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Don't generate a native launcher (.exe) per project; run as "dotnet X.dll" instead.
      Windows Smart App Control / WDAC can block freshly built, unsigned .exe files, which
      breaks `dotnet run` and F5. Containers start the .dll the same way, so nothing else changes.
    -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
