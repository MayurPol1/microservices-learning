{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notifications",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" }
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5101/" }
        }
      },
      "orders": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" }
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5102/" }
        }
      },
      "notifications": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" }
        },
        "Destinations": {
          "primary": { "Address": "http://localhost:5103/" }
        }
      }
    }
  }
}
