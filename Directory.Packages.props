<!--
  Central Package Management: every NuGet version lives here, and .csproj files list
  packages without a Version attribute. In this mono-repo it keeps all services on
  the same versions. In a real company each service often lives in its own repo and
  pins its own versions, which is part of what "independently deployable" means.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Data access: Oracle's official MySQL provider is the one that supports EF Core 10. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />

    <!-- API docs -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />

    <!-- Resilience for service-to-service HTTP calls (Polly v8 underneath). -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />

    <!-- API gateway: YARP is Microsoft's reverse proxy library. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- Messaging: the official RabbitMQ client, used directly so every exchange, queue and ack is visible. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />

    <!-- Observability: OpenTelemetry traces, metrics and logs, exported over OTLP. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
  </ItemGroup>
</Project>
