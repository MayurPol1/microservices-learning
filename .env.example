# Copy this file to .env (in the same folder) and fill in your Stripe TEST secret key.
# .env is in .gitignore: it never goes into git. Never put a key in appsettings.json.
#
# Where to get it: https://dashboard.stripe.com -> switch to test mode (or a Sandbox)
# -> Developers -> API keys -> "Secret key" (starts with sk_test_). Live keys (sk_live_) are refused.
#
# Then run: docker compose up -d --build
STRIPE_SECRET_KEY=
